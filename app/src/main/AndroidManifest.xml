<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
     * top.yukonga.miuix.kmp:miuix-blur 自己声明 minSdk 33（RuntimeShader 那条链它按 33 打的），
     * 我们不支持把底线抬到 33 —— 同学们一堆旧手机会被砍掉。所以这里放行清单合并，
     * 真正的闸门写在调用点：ShelfBar 里 liquidGlass = SDK_INT >= 33，
     * 33 以下自动退回 haze 那颗糊珠子，一行折射代码都不会去碰。
     * 动了这行必须同时动那个判断，否则低版本上是启动崩。
     -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur, top.yukonga.miuix.kmp.shader" />

    <!-- 骨架阶段只带网络；定位、通知、相机等等到对应批次再声明，
         声明一条就要在界面上解释一条，别提前要权限。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 跑步那一块要这三条：定位采轨迹、通知发实况、前台服务让屏灭着也能继续采。
         POST_PROMOTED_NOTIFICATIONS 是 Android 16 的实况更新提升，拿不到就降级普通常驻通知。 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- 扫码签到才用相机；不是必须，没相机也能用这个应用 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- 上课提醒要排一颗精确闹钟。10-20 装机实测：不声明这条的话点开关直接
         SecurityException 闪退 —— 我原先以为 setAlarmClock 不要权限，那是对的 API 文档
         没管住这台 ROM。现在照实声明，并且排之前先问 canScheduleExactAlarms()，
         用户把权限关了也不炸，只是退化成一条可能晚几分钟的闹钟（界面上会说）。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 这条只是让重启后能自己把闹钟排回去。国产 ROM 上开机广播收不收得到，
         取决于用户给没给"自启动"，那个开关我们读不到，所以设置那一行写的是
         "重启后要打开一次 App 才稳"，不装作开机就万事大吉。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      networkSecurityConfig 只给一台服务器开明文：sports.aiit.edu.cn:8082 是 http，不是 https。
      Android 9 起系统默认禁明文，OkHttp 会直接抛
        CLEARTEXT communication to sports.aiit.edu.cn not permitted by network security policy
      界面上表现成"跑量拉不到"，看着像不在校内 —— 10-20 中午同一时刻手机上
      `toybox nc -z sports.aiit.edu.cn 8082` 回 0，端口是通的。
      不用 usesCleartextTraffic="true"：那会把整个 App 的明文都放开，包括带 token 的那批接口。
      注意这一份只管"允不允许"，OkHttp 那边还得**有**明文能力（见 core/net/Http.kt 那段）。
    -->
    <application
        android:name=".AndaXinApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"

        android:icon="@mipmap/ic_launcher_blue"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.AndaXin">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <!--
          桌面那枚可以换：入口从 MainActivity 挪到 alias 上，每一枚图标一条 alias，
          只有选中的那条 enabled —— 换图标是"开一条、关一条"，MainActivity 一直开着，
          所以不会把正在跑的 App 关掉。为什么入口不能留在 MainActivity 上，见
          core/launcher/LauncherIcons.kt 文件头第 ① 条。
          图形在 res/drawable/ic_launcher_fg_*.xml 与 ic_launcher_bg_*.xml。
          五枚都在那一排里可选，出厂立着的是「蓝底青杠」那条。
          （10-25 删掉了「临时标记」那枚方框和琥珀那一枚 —— 方框是骨架期的占位，
            它连带 `<application android:icon>` 一起换成了蓝底那套。）
        -->
        <activity-alias
            android:name=".LauncherBlue"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_blue"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_blue">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias android:name=".LauncherPaper" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_paper" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias android:name=".LauncherInk" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_ink" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias android:name=".LauncherTeal" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_teal" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias android:name=".LauncherIndigo" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_indigo" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".core.run.RunService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- 查寝签到拍照：相机把图写到 cache/checkin/，经 FileProvider 授权给它写 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 上课提醒那颗闹钟。exported=false：只接自己包内投的广播 -->
        <receiver
            android:name="com.andaxin.core.schedule.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.andaxin.action.CLASS_REMIND" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.andaxin.core.schedule.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
